---
import { getYouTubeId } from "../utils/youtube";

const node = Astro.props.node ?? Astro.props;
const videoId = getYouTubeId(node.id ?? node.url);
const title = node.title || "YouTube video";
---

{videoId ? (
	<figure class="youtube-embed">
		<iframe
			src={`https://www.youtube-nocookie.com/embed/${videoId}`}
			title={title}
			loading="lazy"
			referrerpolicy="strict-origin-when-cross-origin"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen
		></iframe>
	</figure>
) : (
	<p class="youtube-invalid">This YouTube link is invalid or unsupported.</p>
)}

<style>
	.youtube-embed {
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: var(--spacing-8) 0;
		background: #000;
	}
	.youtube-embed iframe { width: 100%; height: 100%; border: 0; }
	.youtube-invalid { color: var(--color-muted); font-style: italic; }
</style>
