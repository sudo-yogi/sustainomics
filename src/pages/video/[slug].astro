---
import { getEmDashEntry, decodeSlug } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getYouTubeId } from "../../utils/youtube";
import { addCacheHint } from "../../utils/cache";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");
const { entry: video, cacheHint } = await getEmDashEntry("videos", slug);
if (!video) return Astro.redirect("/404");
addCacheHint(Astro, cacheHint);
const videoId = getYouTubeId(video.data.video_url);
---

<Base title={video.data.title} description={video.data.excerpt} type="article" content={{ collection: "videos", id: video.data.id, slug }}>
	<article class="video-page">
		<a href="/video" class="back">‹ All video</a>
		<p class="kicker">{video.data.category || "Video"}</p>
		<h1>{video.data.title}</h1>
		{video.data.excerpt && <p class="dek">{video.data.excerpt}</p>}
		{videoId ? (
			<div class="player">
				<iframe
					src={`https://www.youtube-nocookie.com/embed/${videoId}`}
					title={video.data.title}
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				></iframe>
			</div>
		) : video.data.thumbnail ? (
			<div class="fallback"><Image image={video.data.thumbnail} /><p>This video does not have a valid YouTube URL yet.</p></div>
		) : (
			<p class="fallback-text">This video does not have a valid YouTube URL yet.</p>
		)}
	</article>
</Base>

<style>
	.video-page { max-width: 960px; margin: 0 auto; padding: var(--spacing-8) var(--spacing-6) var(--spacing-16); }
	.back { display: inline-block; margin-bottom: var(--spacing-6); color: var(--color-muted); font-weight: 600; }
	.kicker { color: var(--color-kicker); font-size: var(--font-size-xs); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-wider); }
	h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin: var(--spacing-2) 0 var(--spacing-4); }
	.dek { max-width: 65ch; color: var(--color-text-secondary); font-size: var(--font-size-lg); margin-bottom: var(--spacing-6); }
	.player { width: 100%; aspect-ratio: 16 / 9; background: #000; }
	.player iframe { width: 100%; height: 100%; border: 0; }
	.fallback { display: grid; gap: var(--spacing-3); color: var(--color-muted); }
	.fallback-text { color: var(--color-muted); }
</style>
